# Runtime profile: harness (H1 default) | classic (A/B legacy pre-routing)
CLINICAL_RUNTIME_MODE=harness

# 蒲公英中医 MVP 环境变量模板
LLM_BASE_URL=
LLM_API_KEY=
LLM_FAST_MODEL=
LLM_DEEP_MODEL=

EMBEDDING_BASE_URL=
EMBEDDING_API_KEY=
EMBEDDING_MODEL=
EMBEDDING_DIMENSIONS=2560
EMBEDDING_BATCH_SIZE=20

RERANK_API_KEY=
RERANK_MODEL=
RERANK_ENDPOINT=

KB_RELEASE_DIR=../assets/knowledge/releases/2026.09.18-agent-ready-r1

# ASR（可选，语音流式输入；未配置则语音按钮隐藏）
ASR_ENABLED=false
ASR_MODEL=qwen-audio-3.0-asr-flash-streaming
ASR_WS_URL=
ASR_API_KEY=
ASR_SAMPLE_RATE=16000
ASR_TIMEOUT_SECONDS=60

# === 会话与账号 ===
# APP_SECRET：会话签名密钥，生产必须为随机串（≥16 位），泄露等于会话可伪造
APP_SECRET=
SESSION_COOKIE_NAME=pgy_session
SESSION_HOURS=12
# 经 HTTPS（Nginx 反代）对外时必须为 true，否则 Cookie 会在明文 HTTP 上传输
COOKIE_SECURE=false
# 账号存储文件（随 data 卷持久化；密码仅存 scrypt 摘要）
AUTH_USERS_FILE=data/users.json
# 会话登记表：登出/失效立即生效（同目录同卷）
AUTH_SESSIONS_FILE=data/sessions.json
# 首次启动建档；已存在的账号不会被覆盖（改密码请在服务器上改文件或后续管理页）
BOOTSTRAP_ADMIN_LOGIN=admin
BOOTSTRAP_ADMIN_PASSWORD=
BOOTSTRAP_ADMIN_NAME=平台管理员
BOOTSTRAP_DOCTOR_LOGIN=doctor
BOOTSTRAP_DOCTOR_PASSWORD=
BOOTSTRAP_DOCTOR_NAME=医生

APP_PORT=8787
