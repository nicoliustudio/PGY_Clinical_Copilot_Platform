# Runtime profile: harness (H1 default) | classic (A/B legacy pre-routing)
CLINICAL_RUNTIME_MODE=harness

# 蒲公英中医 MVP 环境变量模板
LLM_BASE_URL=
LLM_API_KEY=
LLM_FAST_MODEL=
LLM_DEEP_MODEL=

EMBEDDING_BASE_URL=
EMBEDDING_API_KEY=
EMBEDDING_MODEL=
EMBEDDING_DIMENSIONS=2560
EMBEDDING_BATCH_SIZE=20

RERANK_API_KEY=
RERANK_MODEL=
RERANK_ENDPOINT=

KB_RELEASE_DIR=../assets/knowledge/releases/2026.09.4-kb-parity-r1

# ASR（可选，语音流式输入；未配置则语音按钮隐藏）
ASR_ENABLED=false
ASR_MODEL=qwen-audio-3.0-asr-flash-streaming
ASR_WS_URL=
ASR_API_KEY=
ASR_SAMPLE_RATE=16000
ASR_TIMEOUT_SECONDS=60
