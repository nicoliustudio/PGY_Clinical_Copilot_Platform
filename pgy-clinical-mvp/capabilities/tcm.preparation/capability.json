{
  "id": "tcm.preparation",
  "version": "0.1.0",
  "displayName": "制剂与中成药能力",
  "enabled": true,
  "description": "中成药、专家制剂、制剂工艺与用法等制剂知识的临床能力",
  "semanticDescription": "适用于输入中明确要求了解或使用某中成药、某制剂、制剂的工艺/用法等临床任务。基于开放语义判断，不限具体措辞。",
  "provides": [
    "tcm_preparation",
    "proprietary_medicine",
    "expert_preparation",
    "preparation_process_usage",
    "modality:preparation"
  ],
  "positiveExamples": [
    "想了解某个中成药的用法",
    "这个制剂怎么用",
    "某中成药适合这个情况吗"
  ],
  "negativeExamples": [
    "想开一料膏方调理",
    "希望配合针灸治疗"
  ],
  "knowledgeScopes": [
    "tcm.preparation"
  ],
  "semanticOntology": {
    "terms": [
      {
        "term": "modality:preparation",
        "aliases": [
          "成药",
          "中成药",
          "现成膏剂",
          "制剂",
          "成方制剂",
          "不方便煎药",
          "免煎"
        ]
      }
    ]
  },
  "skillIds": [],
  "toolIds": [],
  "treatmentSpecific": true,
  "evidenceObligations": [
    {
      "id": "treatment-asset-evidence",
      "evidenceType": "treatment-asset",
      "discoveryToolIds": [
        "knowledge.search_cards"
      ],
      "hydrationToolIds": [
        "knowledge.get_asset"
      ]
    }
  ],
  "deliveryObligations": [
    {
      "id": "treatment-form-delivery",
      "requiredArtifact": "treatmentFormDecision",
      "requiredFields": [
        "outcome",
        "form",
        "disposition",
        "statement",
        "sourceEvidenceRefs"
      ],
      "materialization": "SOURCE_BOUND",
      "sourceRequiredFields": [
        "asset_id",
        "title",
        "provenance.raw_text",
        "content_hash"
      ]
    }
  ],
  "controlPlaneV21": {
    "rules": [
      {
        "id": "treatment-evidence",
        "produces": {
          "type": "artifact:treatment-evidence",
          "qualifiers": {
            "outcome": "$outcome"
          },
          "producerCapabilityId": "$capability"
        },
        "effects": [
          {
            "op": "retrieve",
            "target": {
              "type": "artifact:treatment-evidence",
              "qualifiers": {
                "outcome": "$outcome"
              }
            }
          }
        ]
      },
      {
        "id": "treatment-draft",
        "produces": {
          "type": "artifact:treatment-draft",
          "qualifiers": {
            "outcome": "$outcome"
          },
          "producerCapabilityId": "$capability",
          "producerRuleId": "$rule"
        },
        "requires": [
          {
            "type": "artifact:clinical-core"
          },
          {
            "type": "artifact:treatment-evidence",
            "qualifiers": {
              "outcome": "$outcome"
            },
            "producerCapabilityId": "$capability"
          }
        ],
        "effects": [
          {
            "op": "commit",
            "target": {
              "type": "artifact:treatment-draft",
              "qualifiers": {
                "outcome": "$outcome"
              }
            }
          }
        ]
      },
      {
        "id": "treatment-delivery",
        "forOutcomes": [
          "modality:preparation"
        ],
        "produces": {
          "type": "artifact:treatment-delivery",
          "qualifiers": {
            "outcome": "$outcome"
          },
          "producerCapabilityId": "$capability",
          "producerRuleId": "$rule"
        },
        "requires": [
          {
            "type": "artifact:treatment-draft",
            "qualifiers": {
              "outcome": "$outcome"
            },
            "producerCapabilityId": "$capability"
          }
        ],
        "effects": [
          {
            "op": "commit",
            "target": {
              "type": "artifact:treatment-delivery",
              "qualifiers": {
                "outcome": "$outcome"
              }
            }
          }
        ]
      }
    ]
  }
}
